/* Comparison Floating Bar */
.comparison-floating-bar {
    position: fixed;
    bottom: 30px;
    left: 0;
    width: 100%;
    display: flex;
    justify-content: center;
    z-index: 1000;
    pointer-events: none; /* Allow clicking through outside the bar */
    animation: slideUpBar 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

.bar-content {
    pointer-events: auto;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(10px);
    padding: 10px 20px;
    border-radius: 50px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.15);
    display: flex;
    align-items: center;
    gap: 20px;
    border: 1px solid rgba(255, 255, 255, 0.5);
}

.count-section {
    display: flex;
    align-items: center;
    gap: 8px;
}

.count-section .label {
    font-size: 0.8rem;
    font-weight: 600;
    color: #7f8c8d;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.count-badge {
    background: #2c3e50;
    color: white;
    padding: 2px 10px;
    border-radius: 12px;
    font-size: 0.85rem;
    font-weight: 700;
}

.count-badge .total {
    opacity: 0.6;
    font-size: 0.75rem;
}

.divider {
    width: 1px;
    height: 24px;
    background: #e0e0e0;
}

.selected-avatars {
    display: flex;
    align-items: center;
    gap: -10px; /* Overlap effect */
}

.uni-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 1.2rem;
    border: 2px solid white;
    box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    transition: transform 0.2s;
    margin-right: -10px; /* Negative margin for overlap */
    position: relative;
    z-index: 1;
}

.uni-avatar:hover {
    transform: translateY(-5px) scale(1.1);
    z-index: 10;
}

.uni-avatar.placeholder {
    background: #f0f2f5;
    border: 2px dashed #ccc;
    box-shadow: none;
    z-index: 0;
}

.uni-avatar mat-icon {
    font-size: 20px;
    width: 20px;
    height: 20px;
}

.bar-actions {
    display: flex;
    align-items: center;
    gap: 10px;
}

.trash-btn {
    color: #e57373;
}

.trash-btn:hover {
    background: rgba(229, 115, 115, 0.1);
}

.compare-btn {
    border-radius: 30px;
    padding: 0 25px;
    height: 40px;
    font-weight: 600;
    letter-spacing: 0.5px;
    box-shadow: 0 4px 15px rgba(255, 64, 129, 0.3);
}

@keyframes slideUpBar {
    from { transform: translateY(100px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
}

/* Mobile Adjustments */
@media (max-width: 600px) {
    .bar-content {
        padding: 10px 15px;
        gap: 10px;
        width: 90%;
        justify-content: space-between;
    }

    .count-section .label {
        display: none;
    }
    
    .divider {
        display: none;
    }
}
